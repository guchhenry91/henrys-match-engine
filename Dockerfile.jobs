# The Match Engine job runner for Cloudflare Containers (cloudflare/worker.js).
# Only the Python requirements are baked in; the CODE is downloaded fresh from the
# public repo on every run (cloudflare/container/run_job.py), so a push to main is
# all it takes to change a job. Rebuild only when requirements.txt changes.
FROM docker.io/library/python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /runner
COPY requirements.txt /runner/requirements.txt
RUN pip install -r /runner/requirements.txt
# soccerdata's TLS client downloads a native library on first use. Publish fits
# leagues in parallel threads, and on a fresh container they all raced to download
# and load it at once -- a segfault (exit -11) four seconds in. Fetch it at build.
RUN python -c "from tls_requests.models.libraries import TLSLibrary; TLSLibrary.load()"
# Cloudflare containers have no /dev/shm, so joblib's process pool cannot start.
ENV JOBLIB_MULTIPROCESSING=0
COPY cloudflare/container/ /runner/
CMD ["python", "/runner/run_job.py"]
