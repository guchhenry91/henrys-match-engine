.gstack/
.playwright-mcp/
*.jpeg
__pycache__/
.deploy.lock

# secrets -- the Render deploy hook and the Telegram bot token must never be committed
*key*.txt
.env

# a second checkout must never be swept in by `git add -A`
.claude/worktrees/

# local caches, not source
data-raw/leagues/cache/
.cache/
.test-tmp/
pytest-cache-files-*/

# scratch files from audits and experiments
_repro.py
_scratch*.py
_tmp*.py
_scratch_out/
_scratch_picks/
_audit*.py
*.pkl

# graphify knowledge graph output (regenerable via `graphify update .`)
graphify-out/

# nflverse CSVs, re-downloadable and large -- cached locally, never committed
data-raw/nfl/_cache/

# API-NFL circuit breaker: a local runtime marker, not project state
data-raw/nfl/_quota.json

# NBA season logs cached from stats.nba.com. Regenerable in 30 requests,
# and 15 seasons of player rows is ~90MB -- not something to carry in git.
data-raw/nba/_cache/
