// Henry's Match Engine on Cloudflare (replaces Render AND the GitHub schedules).
// See cloudflare/worker.js for the whole design; JOBS_MODE switches the jobs
// between "off", "shadow" (a trial copy of the data) and "live".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "henrys-match-engine",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "account_id": "91cd3c13e1deccadc2eb1f337bc40c99",
  "workers_dev": true,
  "preview_urls": false,
  // ONLY the site: scripts/build_site.py copies the pages and data/ into _site.
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/internal/*", "/data/*", "/", "/*.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "henrys-match-engine",
      "database_id": "ec8195ba-a46c-45a6-ab59-2b5acc657473" }
  ],
  // One job container at a time (cloudflare/container/run_job.py).
  "containers": [
    // 2 vCPU / 6 GiB (2026-10-27, cost): memory is billed on the size provisioned, and
    // the biggest job (the soccer publish) peaks at ~1.25 GiB -- run_job.py logs each
    // step's peak. standard-4 (12 GiB) paid for ten times that.
    { "class_name": "JobRunner", "image": "./Dockerfile.jobs",
      "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 12000 }, "max_instances": 2 },
    // The Henryade dashboard's stats proxy (Dockerfile.proxy), one instance.
    { "class_name": "StatsProxy", "image": "./Dockerfile.proxy",
      "instance_type": "basic", "max_instances": 1 }
  ],
  "durable_objects": {
    "bindings": [ { "name": "JOB_RUNNER", "class_name": "JobRunner" },
                  { "name": "STATS_PROXY", "class_name": "StatsProxy" } ]
  },
  "migrations": [ { "tag": "v1-job-runner", "new_sqlite_classes": ["JobRunner"] },
                  { "tag": "v2-stats-proxy", "new_sqlite_classes": ["StatsProxy"] } ],
  // Per-visitor limit on the public odds relay (worker.js oddsRelay): 30 uncached
  // calls a minute per address.
  "ratelimits": [ { "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } } ],
  "vars": {
    "JOBS_MODE": "live",
    "TELEGRAM_FROM_CLOUDFLARE": "on",
    "STATE_URL": "https://henrys-match-engine.henrys-edge-engine.workers.dev"
  },
  // Every minute; cloudflare/worker.js decides which jobs are due.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
